# Gemini API キー(必須)。 https://aistudio.google.com/apikey で取得。
# 課金(Tier 1)有効のキーを前提にしている。TTSはプレビュー版で上限が低いので、
# 開発中のAIナレーション生成は回数を抑えめにすること。
GEMINI_API_KEY=your-gemini-api-key-here

# 文字起こしに使うGeminiモデル(任意、未指定時は gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest

# 参考画像/動画からのスタイル抽出・自動編集に使うモデル(任意、未指定時は gemini-pro-latest)。
# 演出の判断そのものなのでProが既定。コストを抑えたいときは gemini-flash-latest にする。
# GEMINI_STYLE_MODEL=gemini-pro-latest
# GEMINI_AUTO_EDIT_MODEL=gemini-pro-latest

# AIナレーション(読み上げ音声)生成に使うGemini TTSモデル(任意、未指定時は gemini-3.8-flash-tts)
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# 自動編集で「使う画像」が足りない所に出す画像を作るモデル(任意、未指定時は gemini-3.1-flash-image)。1枚数円〜十円かかる。
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Geminiリクエスト間の最小間隔(ミリ秒、任意)。テキスト系の既定は1000、TTSの既定は6500。
# 無料枠のキーで動かす場合は GEMINI_MIN_INTERVAL_MS=6500 にする。
# GEMINI_MIN_INTERVAL_MS=1000
# GEMINI_TTS_MIN_INTERVAL_MS=6500

# /insights(お店のクチコミ検索)で使うGoogle Maps Platform APIキー(任意)。
# Google Cloud ConsoleでPlaces API (New)を有効化し、課金設定した上で取得する。
# https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# 自動編集で作る案の最大数(1か2、未指定時は2)。2だと1案目が手本から遠い・失敗した時だけ2案目を作り、近い方を選ぶ。
# AUTO_EDIT_CANDIDATES=2

# 画像の棚(自動編集でAIが作った画像を貯めて使い回す)を本番でも消えないようにする保存先(任意)。Cloudflare R2。
# 未設定でも動くが、本番で作った画像はデプロイのたびに消える(リポジトリのdata/image-library/の分は残る)。
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET=snsapp-image-library
