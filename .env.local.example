# Gemini API キー(必須)。 https://aistudio.google.com/apikey で取得。
# 無料枠で運用するため、開発中の動作確認はテスト回数を抑えめにすること。
GEMINI_API_KEY=your-gemini-api-key-here

# 使用するGeminiモデル(任意、未指定時は gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# AIナレーション(読み上げ音声)生成に使うGemini TTSモデル(任意、未指定時は gemini-2.5-flash-preview-tts)
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# /insights(お店のクチコミ検索)で使うGoogle Maps Platform APIキー(任意)。
# Google Cloud ConsoleでPlaces API (New)を有効化し、課金設定した上で取得する。
# https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
